-- Meta objects, and the dependency invariants that keep restore and upstream
-- migrations working.
SELECT pgl_test.ok(
    (SELECT count(*) FROM lakekeeper.info) = 1,
    'info returns exactly one row');
 ok 
----
 
(1 row)

SELECT pgl_test.ok(
    (SELECT lakekeeper_schema FROM lakekeeper.info)
        = (SELECT n.nspname
           FROM pg_catalog.pg_class c
           JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
           WHERE c.relname = '_sqlx_migrations' AND c.relkind = 'r'),
    'bound to the schema holding the upstream migrations');
 ok 
----
 
(1 row)

SELECT pgl_test.ok(
    NOT EXISTS (SELECT 1 FROM lakekeeper.check_schema() WHERE status <> 'ok'),
    'every schema check reports ok');
 ok 
----
 
(1 row)

SELECT pgl_test.ok(
    (SELECT count(*) FROM lakekeeper.migration WHERE success)
        = (SELECT migration_count FROM lakekeeper.info),
    'the migration view agrees with the pinned migration count');
 ok 
----
 
(1 row)

-- No installed view depends on an upstream relation. This is what lets
-- CREATE EXTENSION run before Lakekeeper's tables exist, and what keeps an
-- upstream ALTER TABLE from being blocked by this extension.
SELECT pgl_test.ok(
    NOT EXISTS (
        SELECT 1
        FROM pg_catalog.pg_depend d
        JOIN pg_catalog.pg_rewrite r
            ON r.oid = d.objid AND d.classid = 'pg_rewrite'::regclass
        JOIN pg_catalog.pg_depend m
            ON m.objid = r.ev_class
           AND m.classid = 'pg_class'::regclass
           AND m.refclassid = 'pg_extension'::regclass
           AND m.deptype = 'e'
        JOIN pg_catalog.pg_extension e
            ON e.oid = m.refobjid AND e.extname = 'pg_lakekeeper'
        JOIN pg_catalog.pg_class c
            ON c.oid = d.refobjid AND d.refclassid = 'pg_class'::regclass
        JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
        WHERE n.nspname = (SELECT lakekeeper_schema FROM lakekeeper.info)),
    'no installed view depends on an upstream relation');
 ok 
----
 
(1 row)

SELECT pgl_test.ok(
    NOT EXISTS (
        SELECT 1
        FROM pg_catalog.pg_depend d
        JOIN pg_catalog.pg_extension e ON e.oid = d.refobjid
        JOIN pg_catalog.pg_class c ON c.oid = d.objid
        JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
        WHERE d.refclassid = 'pg_extension'::regclass
          AND d.classid = 'pg_class'::regclass
          AND d.deptype = 'e'
          AND e.extname = 'pg_lakekeeper'
          AND n.nspname <> 'lakekeeper'),
    'every installed relation lives in the lakekeeper schema');
 ok 
----
 
(1 row)

SELECT pgl_test.ok(
    to_regprocedure('lakekeeper._define(text)') IS NULL,
    'the installation helper is dropped when installation finishes');
 ok 
----
 
(1 row)

DROP EXTENSION pg_lakekeeper;
CREATE EXTENSION pg_lakekeeper;
SELECT pgl_test.ok(
    (SELECT count(*) FROM lakekeeper.info) = 1,
    'the extension reinstalls against a migrated database');
 ok 
----
 
(1 row)

