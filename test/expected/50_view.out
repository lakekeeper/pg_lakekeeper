SELECT full_name, format_version, current_version_id, current_schema_id, is_live
FROM lakekeeper.iceberg_view
ORDER BY full_name;
     full_name      | format_version | current_version_id | current_schema_id | is_live 
--------------------+----------------+--------------------+-------------------+---------
 sales.eu.eu_orders | v1             |                  2 |                 1 | t
(1 row)

SELECT v.version_id, v.schema_id, v.default_catalog, v.default_namespace_name,
       v.summary
FROM lakekeeper.view_version v
ORDER BY v.version_id;
 version_id | schema_id | default_catalog | default_namespace_name |          summary           
------------+-----------+-----------------+------------------------+----------------------------
          1 |         0 |                 | {sales,eu}             | {"engine-name": "fixture"}
          2 |         1 |                 | {sales,eu}             | {"engine-name": "fixture"}
(2 rows)

SELECT r.version_id, r.typ, r.dialect, r.sql
FROM lakekeeper.view_representation r
ORDER BY r.version_id, r.dialect;
 version_id | typ | dialect |                 sql                 
------------+-----+---------+-------------------------------------
          1 | sql | spark   | SELECT order_id, amount FROM orders
          1 | sql | trino   | SELECT order_id, amount FROM orders
          2 | sql | spark   | SELECT order_id FROM orders
          2 | sql | trino   | SELECT order_id FROM orders
(4 rows)

SELECT pgl_test.ok(
    (SELECT current_version_id FROM lakekeeper.iceberg_view
     WHERE full_name = 'sales.eu.eu_orders') = 2,
    'the view reports the version the catalog serves');
 ok 
----
 
(1 row)

SELECT pgl_test.ok(
    (SELECT count(*) FROM lakekeeper.view_version_log) = 2,
    'the version log records both versions');
 ok 
----
 
(1 row)

SELECT pgl_test.ok(
    (SELECT array_agg(v.name ORDER BY v.name) FROM lakekeeper.iceberg_view v
     WHERE v.is_live AND v.namespace_name = ARRAY['sales', 'eu'])
        = (SELECT array_agg(i->>'name' ORDER BY i->>'name')
           FROM pgl_test.api a, jsonb_array_elements(a.body->'identifiers') i
           WHERE a.name = 'view_list'),
    'the view listing matches the view list endpoint');
 ok 
----
 
(1 row)

SELECT p.key, p.value FROM lakekeeper.view_property p ORDER BY p.key;
  key  |   value   
-------+-----------
 owner | analytics
