-- Grant assignments.
SELECT pgl_test.inlined('SELECT * FROM lakekeeper."grant"');
 inlined 
---------
 
(1 row)

SELECT resource_type, resource_name, privilege, principal_type,
       CASE principal_type
           WHEN 'user' THEN principal_id
           ELSE (SELECT r.name FROM lakekeeper.role r WHERE r.role_id::text = principal_id)
       END AS principal,
       tabular_type
FROM lakekeeper."grant"
ORDER BY resource_type, privilege;
 resource_type |   resource_name    |    privilege     | principal_type | principal  | tabular_type  
---------------+--------------------+------------------+----------------+------------+---------------
 namespace     | sales.eu           | get_metadata     | user           | oidc~alice | 
 project       | Default Project    | create_warehouse | role           | analysts   | 
 server        |                    | list_users       | user           | oidc~alice | 
 tabular       | sales.eu.orders    | read_data        | user           | oidc~alice | table
 tabular       | logs.delta_events  | read_data        | role           | analysts   | generic-table
 tabular       | sales.eu.eu_orders | select           | role           | analysts   | view
 tag           | pii                | apply            | role           | analysts   | 
 warehouse     | wh_hard            | use              | role           | analysts   | 
(8 rows)

SELECT pgl_test.ok(
    (SELECT count(*) FROM lakekeeper."grant"
     WHERE principal_type = 'user' AND (user_id IS NULL OR role_id IS NOT NULL)) = 0
    AND (SELECT count(*) FROM lakekeeper."grant"
         WHERE principal_type = 'role' AND (role_id IS NULL OR user_id IS NOT NULL)) = 0,
    'exactly one principal column is set per row');
 ok 
----
 
(1 row)

SELECT pgl_test.ok(
    (SELECT count(*) FROM lakekeeper."grant" WHERE resource_type = 'server'
                                               AND resource_name IS NOT NULL) = 0,
    'a server grant names no resource');
 ok 
----
 
(1 row)

SELECT pgl_test.ok(
    (SELECT count(*) FROM lakekeeper."grant"
     WHERE resource_type <> 'server' AND resource_name IS NULL) = 0,
    'every other grant resolves a resource name');
 ok 
----
 
(1 row)

-- Compared as whole grants, not counted: principal, privilege and resource.
SELECT pgl_test.ok(
    (SELECT jsonb_agg(jsonb_build_object(
                'privilege', g.privilege,
                'principal', jsonb_build_object('role', g.role_id),
                'resource', jsonb_build_object('type', g.resource_type,
                                               'warehouse-id', g.warehouse_id))
            ORDER BY g.privilege)
     FROM lakekeeper."grant" g
     WHERE g.resource_type = 'warehouse')
    = (SELECT jsonb_agg(x - 'created-at' - 'recognized' ORDER BY x->>'privilege')
       FROM pgl_test.api a, jsonb_array_elements(a.body->'grants') x
       WHERE a.name = 'grant_list'),
    'the warehouse grant matches the endpoint, principal and resource included');
 ok 
----
 
(1 row)

