(1 row)

SELECT pgl_test.ok(
    lakekeeper.load_table(t.warehouse_id, ARRAY['logs'], 'delta_events') IS NULL,
    'a generic table is not returned as an Iceberg table')
FROM lakekeeper.warehouse t WHERE t.warehouse_name = 'wh_hard';
 ok 
